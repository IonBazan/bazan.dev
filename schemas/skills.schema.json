{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Skills",
  "description": "data/resume/skills.yaml — list of skill categories, rendered in order.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "skills"],
    "additionalProperties": false,
    "properties": {
      "name": { "type": "string", "description": "Category name, e.g. Programming languages." },
      "skills": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
